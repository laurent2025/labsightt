# ---------------------------------------------------------------------------
# LabSight API server configuration.
#
# Copy to `.env` and load it however you prefer. Node does not read .env files
# automatically, so either export these before starting the server, or run
# `node --env-file=.env server/main.js`.
# ---------------------------------------------------------------------------

# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# Where the SQLite database file lives. Use ":memory:" for a throwaway instance.
DB_PATH=./data/labsight.db

# Set to "production" to mark session cookies Secure (HTTPS only).
NODE_ENV=development

# --- Inference (REQUIRED to analyse a specimen) ------------------------------
# The Roboflow credential is read ONLY here. It is never sent to the browser,
# never returned by any endpoint, and never written to the database.
# Without these, analysis fails with a clear error instead of inventing results.
ROBOFLOW_ENDPOINT=https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>
ROBOFLOW_API_KEY=

# How long to wait for the provider before giving up, in milliseconds.
ROBOFLOW_TIMEOUT_MS=60000

# --- First-run bootstrap -----------------------------------------------------
# The server creates one account per role when that username is missing. An
# account that already exists is never modified, so these cannot reset a
# password you have since changed.
#
#   technologist -> runs analysis     supervisor -> verifies (second person)
#   director     -> releases
#
# All three are needed to exercise the two-person verification gate: a report
# cannot be verified by the technologist who originated it. Leave any password
# blank to have a strong one generated and printed to the console.
BOOTSTRAP_TECH_USER=tech
BOOTSTRAP_TECH_PASSWORD=

BOOTSTRAP_SUPERVISOR_USER=supervisor
BOOTSTRAP_SUPERVISOR_PASSWORD=

BOOTSTRAP_DIRECTOR_USER=director
BOOTSTRAP_DIRECTOR_PASSWORD=
